generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Module {
  id             String          @id @default(uuid())
  title          String
  color          String          @default("#3b82f6")
  budget         Float?          // Teto mensal de gastos do módulo (R$)
  createdAt      DateTime        @default(now())
  cards          Card[]
  recurringTasks RecurringTask[]
}

// PLANILHA DE ROTINAS E FINANÇAS
model RecurringTask {
  id        String   @id @default(uuid())
  title     String
  amount    Float?   // Valor (R$) para controle financeiro
  dueDay    Int?     // Dia do vencimento (ex: 15)
  active    Boolean  @default(true)
  type          String  @default("EXPENSE") // "INCOME" | "EXPENSE"
  paymentMethod String  @default("BOLETO")  // "PIX" | "BOLETO" | "CREDIT_CARD" | "DEBIT"
  // "FINANCE" = conta fixa do financeiro · "TASK" = rotina que gera card no Kanban
  kind          String  @default("FINANCE")
  frequency     String  @default("MONTHLY") // "MONTHLY" | "WEEKLY"
  weekday       Int?    // 0 = domingo … 6 = sábado (rotinas semanais)
  priority      String  @default("Normal")
  
  moduleId  String?
  module    Module?  @relation(fields: [moduleId], references: [id])
  
  cards        Card[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Board {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  columns   Column[]
}

model Column {
  id      String  @id @default(uuid())
  title   String
  order   Int
  isDone  Boolean @default(false)
  boardId String
  board   Board   @relation(fields: [boardId], references: [id])
  cards   Card[]
}

model Card {
  id              String    @id @default(uuid())
  title           String
  description     String?
  priority        String    @default("Normal")
  dueDate         DateTime?
  emailAlert      Boolean   @default(true)
  
  completed       Boolean   @default(false)
  completedAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  order           Int
  columnId        String
  column          Column    @relation(fields: [columnId], references: [id])
  
  moduleId        String?
  module          Module?   @relation(fields: [moduleId], references: [id])

  recurringTaskId String?
  recurringTask   RecurringTask? @relation(fields: [recurringTaskId], references: [id])

  history         History[]
  comments        Comment[]

  // Vínculo financeiro (Lançamentos ligados a este card)
  transactions    Transaction[]
}

model History {
  id        String   @id @default(uuid())
  action    String
  details   String
  user      String
  timestamp DateTime @default(now())
  
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  user      String
  createdAt DateTime @default(now())
  
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                 String    @id @default(uuid())
  description        String
  amount             Float
  type               String    // "INCOME" (Receita) ou "EXPENSE" (Despesa)
  category           String    // "Moradia", "Faculdade", "Alimentação", etc.
  paymentMethod      String    // "PIX", "BOLETO", "CREDIT_CARD"
  dueDate            DateTime
  paid               Boolean   @default(false)
  paidAt             DateTime?
  
  // Controle de Parcelamento Futuro
  isInstallment      Boolean   @default(false)
  installmentCurrent Int?
  installmentTotal   Int?
  installmentId      String?

  notes              String?

  // Origem: conta fixa que gerou este lançamento
  recurringTaskId    String?
  recurringTask      RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)

  // Vínculo opcional com a Pipeline / Card do Kanban
  cardId             String?
  card               Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([dueDate])
  @@index([installmentId])
}

// METAS / RESERVAS (caixinhas)
model Goal {
  id        String    @id @default(uuid())
  title     String
  target    Float
  saved     Float     @default(0)
  monthly   Float?    // Aporte planejado por mês (entra na projeção)
  deadline  DateTime?
  color     String    @default("#10B981")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
