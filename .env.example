# Banco (Neon/PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@host/neondb?schema=pends"

# Login
AUTH_EMAIL="voce@exemplo.com"
AUTH_PASSWORD="troque-esta-senha"
# Segredo que assina a sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=""

# Lembretes diários por e-mail (opcional — sem a chave, o e-mail só aparece no log)
RESEND_API_KEY=""
REMINDER_TO=""            # padrão: AUTH_EMAIL
REMINDER_FROM="Pends <onboarding@resend.dev>"
# A Vercel Cron manda este segredo no header Authorization
CRON_SECRET=""
